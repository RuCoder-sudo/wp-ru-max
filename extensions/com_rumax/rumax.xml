<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">
  <name>com_rumax</name>
  <author>RuCoder / WP Ru-max Joomla Port</author>
  <creationDate>2026-09-06</creationDate>
  <copyright>Copyright (C) RuCoder</copyright>
  <license>GNU General Public License version 2 or later</license>
  <version>1.0.2</version>
  <description>Интеграция Joomla с мессенджером MAX: публикации, уведомления, автопостинг, виджет и живой чат.</description>
  <namespace path="admin/src">Joomla\Component\Rumax\Administrator</namespace>
  <administration>
    <menu link="index.php?option=com_rumax" img="class:comment">Ru-max</menu>
    <files folder="admin">
      <filename>rumax.php</filename>
      <folder>src</folder>
      <folder>sql</folder>
      <folder>tmpl</folder>
    </files>
  </administration>
  <files folder="site">
    <filename>rumax.php</filename>
  </files>
  <media destination="com_rumax" folder="media">
    <folder>assets</folder>
  </media>
  <install>
    <sql>
      <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
    </sql>
  </install>
  <uninstall>
    <sql>
      <file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
    </sql>
  </uninstall>
  <config>
    <fields name="params">
      <fieldset name="basic">
        <field name="note" type="note" label="Ru-max" description="Основные параметры хранятся в панели компонента." />
      </fieldset>
    </fields>
  </config>
</extension>