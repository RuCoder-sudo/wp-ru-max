<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
  <name>plg_system_rumax</name>
  <author>RuCoder / WP Ru-max Joomla Port</author>
  <version>1.0.2</version>
  <description>Глобальный виджет MAX, ассеты, очередь и уведомления Ru-max.</description>
  <files>
    <filename plugin="rumax">rumax.php</filename>
  </files>
  <config>
    <fields name="params">
      <fieldset name="basic">
        <field name="load_widget" type="radio" default="1" label="Загружать виджет" layout="joomla.form.field.radio" filter="boolean"><option value="1">Да</option><option value="0">Нет</option></field>
      </fieldset>
    </fields>
  </config>
</extension>